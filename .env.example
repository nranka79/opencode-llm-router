# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored — it will NEVER be committed.
# The plugin auto-loads `.env` from the working directory or the plugin folder.

# --- Free tier: Token Harbor free deepseek-v4-flash --------------------------
TOKENHARBOR_API_KEY=

# --- Subscription tier: OpenCode Go keys (round-robin) ----------------------
OPENCODE_GO_KEY_1=
OPENCODE_GO_KEY_2=
OPENCODE_GO_KEY_3=
OPENCODE_GO_KEY_4=
OPENCODE_GO_KEY_5=

# --- API (paid) tier: OpenRouter --------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- API (paid) tier: Azure OpenAI (optional) --------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview