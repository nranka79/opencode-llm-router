# Copy this file to `.env` and fill in your real key.
# `.env` is gitignored — it will NEVER be committed.
# The plugin auto-loads `.env` from the working directory or from next to
# llm-router-core.ts (i.e. ~/.config/opencode/.env, not inside plugins/).

# Issued at https://admin.ahfl.in/gateway-keys (distinct from the OUTBOUND
# provider keys managed at /keys-admin — this is the INBOUND key that lets
# THIS plugin call the gateway). Shown once at issue time; if lost, revoke
# it there and issue a new one.
LLM_GATEWAY_API_KEY=

# Only needed to point at something other than production.
# LLM_GATEWAY_BASE_URL=https://llm.ahfl.in/v1

# Usage-metering identity sent to the gateway as X-Hermes-User-Id /
# X-Hermes-User-Label. Optional — the gateway records "unknown" when absent.
LLM_GATEWAY_USER_ID=
LLM_GATEWAY_USER_LABEL=
